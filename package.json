{
    "name": "website",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "biome check",
        "format": "biome format --write",
        "dev:vinext": "vite dev --port 3001",
        "build:vinext": "vite build",
        "start:vinext": "vite preview",
        "deploy:vinext": "vinext-cloudflare deploy --warm-cache",
        "deploy:response-store": "cf deploy --prebuilt --mode production --worker website-response-store"
    },
    "dependencies": {
        "@cloudflare/workers-response-store": "^1.2.0",
        "@vinext/cloudflare": "^1.4.0",
        "next": "16.2.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-server-dom-webpack": "^19.3.1",
        "vinext": "^1.4.6"
    },
    "devDependencies": {
        "@biomejs/biome": "2.2.0",
        "@cloudflare/vite-plugin": "2.0.0-rc.1",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitejs/plugin-rsc": "^0.5.39",
        "babel-plugin-react-compiler": "1.0.0",
        "cf": "^1.0.0-rc.1",
        "oxc-transform-react": "^0.158.0",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vite": "8.3.0"
    },
    "ignoreScripts": [
        "sharp",
        "unrs-resolver"
